page {
    --brand: #2f6fed;
    --expense: #d9534f;
    --income: #2f9e6b;
    --text-primary: #1f2329;
    --text-secondary: #8a8f99;
    --surface: #ffffff;
    --page-bg: #f5f7fa;
    background: var(--page-bg);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 48rpx;
}

.card {
    background: var(--surface);
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
}

.section-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 8rpx 8rpx 20rpx;
    font-size: 30rpx;
    font-weight: 500;
}

.section-hint {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.state {
    padding: 80rpx 24rpx;
    text-align: center;
    font-size: 26rpx;
    color: var(--text-secondary);
}

.expense {
    color: var(--expense);
}

.income {
    color: var(--income);
}

.btn-primary {
    background: var(--brand);
    color: #ffffff;
    border-radius: 16rpx;
    font-size: 30rpx;
    line-height: 88rpx;
    text-align: center;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 96rpx;
    border-bottom: 1rpx solid #f0f1f3;
}

.row:last-child {
    border-bottom: none;
}

.row-label {
    font-size: 28rpx;
}

.row-value {
    font-size: 26rpx;
    color: var(--text-secondary);
}

.form-row {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.form-input {
    flex: 1;
    height: 80rpx;
    padding: 0 20rpx;
    border-radius: 12rpx;
    background: #f5f7fa;
    font-size: 28rpx;
}

.mini-btn {
    margin-left: 12rpx;
    padding: 0 24rpx;
    line-height: 80rpx;
    border-radius: 12rpx;
    background: var(--brand);
    color: #ffffff;
    font-size: 26rpx;
    text-align: center;
    white-space: nowrap;
}

.mini-btn.ghost {
    background: #f2f3f5;
    color: var(--text-primary);
}

.mini-btn.danger {
    background: #fdeceb;
    color: var(--expense);
}

.list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
}

.list-item:last-child {
    border-bottom: none;
}

.item-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
}

.item-title {
    font-size: 28rpx;
}

.item-sub {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.item-actions {
    display: flex;
    align-items: center;
}

.hint-text {
    padding: 16rpx 8rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
    line-height: 1.6;
}

.month-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 32rpx;
}

.month-btn {
    width: 64rpx;
    height: 64rpx;
    line-height: 60rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #f2f3f5;
    font-size: 40rpx;
    color: var(--text-secondary);
}

.month-label {
    font-size: 30rpx;
    font-weight: 500;
}

.type-switch {
    display: flex;
    background: #f2f3f5;
    border-radius: 12rpx;
    padding: 6rpx;
}

.type-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    line-height: 64rpx;
    color: var(--text-secondary);
    border-radius: 10rpx;
}

.type-item.active {
    background: #ffffff;
    color: var(--brand);
}
