page {
    --brand: #2f6fed;
    --expense: #d9534f;
    --income: #2f9e6b;
    --text-primary: #1f2329;
    --text-secondary: #8a8f99;
    --surface: #ffffff;
    --page-bg: #f5f7fa;
    background: var(--page-bg);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 24rpx 48rpx;
}

/* 云端降级提示：概览页和记一笔页都要显示，必须完整换行不能省略 */
.storage-banner {
    display: block;
    margin-bottom: 24rpx;
    padding: 20rpx 28rpx;
    border-radius: 16rpx;
    background: #fff6e5;
    color: #8a5a00;
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
}

.card {
    box-sizing: border-box;
    min-width: 0;
    background: var(--surface);
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
}

/* 单行省略：flex 子项必须 min-width:0，否则小程序 text 会撑破容器把相邻内容挤出屏幕 */
.ellipsis {
    display: block;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

/* 卡片标题行：左边标题、右边次要操作（查看全部 / 说明文字） */
.card-head {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
}

.card-head .section-title {
    flex: 1;
    min-width: 0;
}

.section-title {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    align-items: baseline;
    justify-content: space-between;
    padding: 8rpx 8rpx 20rpx;
    font-size: 30rpx;
    font-weight: 500;
    line-height: 1.4;
}

.section-hint {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.state {
    padding: 80rpx 24rpx;
    text-align: center;
    font-size: 26rpx;
    line-height: 1.6;
    color: var(--text-secondary);
}

.expense {
    color: var(--expense);
}

.income {
    color: var(--income);
}

.btn-primary {
    background: var(--brand);
    color: #ffffff;
    border-radius: 16rpx;
    font-size: 30rpx;
    line-height: 88rpx;
    text-align: center;
}

.row {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    min-height: 96rpx;
    border-bottom: 1rpx solid #f0f1f3;
}

.row:last-child {
    border-bottom: none;
}

/* 左标签不压缩，右值可收缩省略 */
.row-label {
    flex-shrink: 0;
    min-width: 0;
    font-size: 28rpx;
}

.row-value {
    min-width: 0;
    margin-left: 16rpx;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: right;
    font-size: 26rpx;
    color: var(--text-secondary);
}

.form-row {
    display: flex;
    min-width: 0;
    align-items: center;
    margin-bottom: 16rpx;
}

.form-input {
    flex: 1;
    min-width: 0;
    height: 80rpx;
    padding: 0 20rpx;
    border-radius: 12rpx;
    background: #f5f7fa;
    font-size: 28rpx;
}

.mini-btn {
    flex-shrink: 0;
    margin-left: 12rpx;
    padding: 0 24rpx;
    line-height: 80rpx;
    border-radius: 12rpx;
    background: var(--brand);
    color: #ffffff;
    font-size: 26rpx;
    text-align: center;
    white-space: nowrap;
}

.mini-btn.ghost {
    background: #f2f3f5;
    color: var(--text-primary);
}

.mini-btn.danger {
    background: #fdeceb;
    color: var(--expense);
}

.list-item {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
}

.list-item:last-child {
    border-bottom: none;
}

.item-main {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
}

.item-title {
    display: block;
    min-width: 0;
    overflow-wrap: break-word;
    font-size: 28rpx;
}

.item-sub {
    display: block;
    min-width: 0;
    margin-top: 6rpx;
    overflow-wrap: break-word;
    font-size: 22rpx;
    line-height: 1.5;
    color: var(--text-secondary);
}

.item-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin-left: 12rpx;
}

/* 长说明文字必须完整换行，不能省略 */
.hint-text {
    display: block;
    padding: 16rpx 8rpx;
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
    color: var(--text-secondary);
}

.month-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 32rpx;
}

.month-btn {
    flex-shrink: 0;
    width: 64rpx;
    height: 64rpx;
    line-height: 60rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #f2f3f5;
    font-size: 40rpx;
    color: var(--text-secondary);
}

.month-label {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 30rpx;
    font-weight: 500;
}

.type-switch {
    display: flex;
    background: #f2f3f5;
    border-radius: 12rpx;
    padding: 6rpx;
}

.type-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    line-height: 64rpx;
    color: var(--text-secondary);
    border-radius: 10rpx;
}

.type-item.active {
    background: #ffffff;
    color: var(--brand);
}
