<view class="page">
    <view class="card">
        <text class="section-title">{{editingId ? '编辑账户' : '新增账户'}}</text>
        <view class="form-row">
            <input class="form-input" placeholder="账户名称，如 信用卡" value="{{formName}}" bindinput="onNameInput" />
        </view>
        <view class="form-row">
            <input class="form-input" type="digit" placeholder="初始余额（元），可留空" value="{{formInitial}}" bindinput="onInitialInput" />
        </view>
        <view class="form-row">
            <view class="mini-btn ghost" wx:if="{{editingId}}" bindtap="onCancelEdit">取消</view>
            <view class="mini-btn" bindtap="onSave">{{editingId ? '保存修改' : '添加账户'}}</view>
        </view>
        <text class="hint-text">已内置「默认账户」，打开即可记账，无需先添加账户。当前余额 = 初始余额 + 该账户全部收入 − 全部支出。</text>
    </view>

    <view class="card">
        <text class="section-title">支付账户</text>
        <view wx:if="{{rows.length === 0}}" class="state">还没有账户</view>
        <view wx:if="{{rows.length > 0}}" class="list-item" wx:for="{{rows}}" wx:key="id">
            <view class="item-main">
                <text class="item-title">{{item.name}}<text wx:if="{{item.isDefault}}" class="default-tag">默认</text></text>
                <text class="item-sub">初始 ¥ {{item.initialBalanceText}} · 当前 ¥ {{item.balanceText}}</text>
            </view>
            <view class="item-actions">
                <view class="mini-btn ghost" data-id="{{item.id}}" catchtap="onEdit">编辑</view>
                <view wx:if="{{!item.isDefault}}" class="mini-btn danger" data-id="{{item.id}}" catchtap="onDelete">删除</view>
            </view>
        </view>
    </view>
</view>
