.type-switch {
    display: flex;
    background: #f2f3f5;
    border-radius: 12rpx;
    padding: 6rpx;
}

.type-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    line-height: 64rpx;
    color: var(--text-secondary);
    border-radius: 10rpx;
}

.type-item.active {
    background: #ffffff;
    color: var(--brand);
}

.amount-row {
    display: flex;
    min-width: 0;
    align-items: center;
    margin-top: 40rpx;
    padding-bottom: 12rpx;
    border-bottom: 1rpx solid #f0f1f3;
}

.amount-symbol {
    flex-shrink: 0;
    /* 符号比数字小一号，居中对齐时视觉重心偏高，往下压一点和数字基线对齐 */
    padding-top: 6rpx;
    font-size: 44rpx;
    line-height: 1;
}

/* 小程序 input 的默认高度是 1.4rem，只调 font-size 不会把它撑高，
   字号一超过这个高度文字就被上下裁掉，所以必须显式写 height。 */
.amount-input {
    flex: 1;
    min-width: 0;
    height: 100rpx;
    min-height: 100rpx;
    margin-left: 16rpx;
    padding: 0;
    font-size: 56rpx;
    line-height: 100rpx;
    color: var(--text-primary);
}

/* 未输入时的 0.00 比正文更淡，避免和真实金额抢注意力 */
.amount-placeholder {
    color: #c8ced8;
}

.note-input {
    flex: 1;
    margin-left: 24rpx;
    text-align: right;
    font-size: 26rpx;
}

/* 右侧是「当前选中的值」，比纯灰的说明文字更需要被读清 */
.page .row-value {
    flex: 1;
    color: #4e5969;
}

/* 三个 picker 行加 › 提示可点，和概览页分类行用同一套视觉语言 */
.row-chevron {
    flex-shrink: 0;
    margin-left: 8rpx;
    font-size: 28rpx;
    line-height: 1;
    color: #c8ced8;
}

.form-hint {
    display: block;
    margin-top: 20rpx;
    text-align: center;
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
    color: var(--text-secondary);
}

/* 保存按钮：从「贴在灰底上的蓝块」改成有重量感的主操作。
   两个坑一起处理：
   1. 微信内置 `button:not([size=mini]){width:184px}` 特异性 (0,1,1) 高于单类，
      单写 .save-btn 压不住，按钮会缩成一个 184px 的窄块悬在中间 —— 加 .page 前缀到 (0,2,0)。
   2. 圆角比卡片(20rpx)略大、加一层同色投影，让它浮起来而不是糊在背景里。 */
.page .save-btn {
    width: 100%;
    height: 96rpx;
    margin: 8rpx 0 40rpx;
    padding: 0;
    border-radius: 24rpx;
    font-size: 32rpx;
    font-weight: 500;
    line-height: 96rpx;
    box-shadow: 0 10rpx 28rpx rgba(47, 111, 237, 0.24);
}

/* 微信 button 默认用 ::after 画 1rpx 边框，不清掉会在圆角外露出一圈白边 */
.save-btn::after {
    border: none;
}

/* hover / disabled 都用双类名抬高特异性：微信给 button 写的
   `button[disabled]:not([type])` 是 (0,2,1)，单类压不过它 */
.save-btn.save-btn-hover {
    background: #2563d8;
    box-shadow: 0 4rpx 12rpx rgba(47, 111, 237, 0.18);
}

/* 保存中：不要落回微信默认的灰色禁用态，保持蓝色但变浅，避免闪一下灰块 */
.save-btn.btn-primary[disabled] {
    background: #aac1f4;
    color: #ffffff;
    box-shadow: none;
}

/* 最近记录卡：放在保存按钮下方，作为「刚记的那笔」的即时确认 */
.recent-card {
    margin-top: 4rpx;
    margin-bottom: 0;
}

.recent-hint {
    flex-shrink: 0;
    padding: 8rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}
