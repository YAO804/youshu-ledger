.type-switch {
    display: flex;
    background: #f2f3f5;
    border-radius: 12rpx;
    padding: 6rpx;
}

.type-item {
    flex: 1;
    text-align: center;
    font-size: 28rpx;
    line-height: 64rpx;
    color: var(--text-secondary);
    border-radius: 10rpx;
}

.type-item.active {
    background: #ffffff;
    color: var(--brand);
}

.amount-row {
    display: flex;
    align-items: center;
    margin-top: 40rpx;
    padding-bottom: 8rpx;
    border-bottom: 1rpx solid #f0f1f3;
}

.amount-symbol {
    font-size: 40rpx;
}

.amount-input {
    flex: 1;
    margin-left: 16rpx;
    font-size: 56rpx;
}

.note-input {
    flex: 1;
    margin-left: 24rpx;
    text-align: right;
    font-size: 26rpx;
}

.form-hint {
    display: block;
    margin-top: 20rpx;
    text-align: center;
    font-size: 24rpx;
    color: var(--text-secondary);
}
