<view class="page">
    <view wx:if="{{storageNotice}}" class="storage-banner">{{storageNotice}}</view>

    <view class="card">
        <view class="type-switch">
            <view class="type-item {{formType === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="onTypeChange">支出</view>
            <view class="type-item {{formType === 'income' ? 'active' : ''}}" data-type="income" bindtap="onTypeChange">收入</view>
        </view>
        <view class="amount-row">
            <text class="amount-symbol">¥</text>
            <input class="amount-input" type="digit" placeholder="0.00" placeholder-class="amount-placeholder" value="{{amount}}" bindinput="onAmountInput" />
        </view>
    </view>

    <view class="card">
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="row">
                <text class="row-label">分类</text>
                <text class="row-value">{{categoryName}}</text>
                <text class="row-chevron">›</text>
            </view>
        </picker>
        <picker mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="onAccountChange">
            <view class="row">
                <text class="row-label">支付账户</text>
                <text class="row-value">{{accountName}}</text>
                <text class="row-chevron">›</text>
            </view>
        </picker>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
            <view class="row">
                <text class="row-label">日期</text>
                <text class="row-value">{{date}}</text>
                <text class="row-chevron">›</text>
            </view>
        </picker>
        <view class="row">
            <text class="row-label">备注</text>
            <input class="note-input" placeholder="选填" value="{{note}}" bindinput="onNoteInput" />
        </view>
    </view>

    <button class="btn-primary save-btn" hover-class="save-btn-hover" disabled="{{saving}}" bindtap="onSubmit">{{saving ? '保存中…' : '保存'}}</button>
    <text wx:if="{{hintText}}" class="form-hint">{{hintText}}</text>

    <!-- 就地确认：保存后不回概览页，刚记的那笔立刻出现在这里，记错了直接长按删 -->
    <view class="card recent-card">
        <view class="card-head">
            <text class="section-title">最近记录</text>
            <text class="recent-hint">最近 5 笔 · 含往月</text>
        </view>
        <record-list
            records="{{recentRecords}}"
            empty="还没有账目，保存后就会出现在这里"
            hint="长按账目可删除"
            bind:delete="onDeleteRecord"
        />
    </view>
</view>
