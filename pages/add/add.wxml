<view class="page">
    <view class="card">
        <view class="type-switch">
            <view class="type-item {{formType === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="onTypeChange">支出</view>
            <view class="type-item {{formType === 'income' ? 'active' : ''}}" data-type="income" bindtap="onTypeChange">收入</view>
        </view>
        <view class="amount-row">
            <text class="amount-symbol">¥</text>
            <input class="amount-input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmountInput" />
        </view>
    </view>

    <view class="card">
        <view class="row" bindtap="onPickCategory">
            <text class="row-label">分类</text>
            <text class="row-value">{{categoryName}}</text>
        </view>
        <view class="row" bindtap="onPickAccount">
            <text class="row-label">支付账户</text>
            <text class="row-value">{{accountName}}</text>
        </view>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
            <view class="row">
                <text class="row-label">日期</text>
                <text class="row-value">{{date}}</text>
            </view>
        </picker>
        <view class="row">
            <text class="row-label">备注</text>
            <input class="note-input" placeholder="选填" value="{{note}}" bindinput="onNoteInput" />
        </view>
    </view>

    <button class="btn-primary" bindtap="onSubmit">保存</button>
    <text class="form-hint">{{hintText}}</text>
</view>
