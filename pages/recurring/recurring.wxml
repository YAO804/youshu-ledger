<view class="page">
    <view class="card">
        <text class="section-title">新增周期规则</text>
        <view class="type-switch">
            <view class="type-item {{formType === 'expense' ? 'active' : ''}}" data-type="expense" bindtap="onTypeChange">支出</view>
            <view class="type-item {{formType === 'income' ? 'active' : ''}}" data-type="income" bindtap="onTypeChange">收入</view>
        </view>
        <view class="form-row" style="margin-top: 24rpx">
            <input class="form-input" type="digit" placeholder="金额（元）" value="{{formAmount}}" bindinput="onAmountInput" />
        </view>
        <picker mode="selector" range="{{categoryNames}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="row">
                <text class="row-label">分类</text>
                <text class="row-value">{{categoryName}}</text>
            </view>
        </picker>
        <picker mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="onAccountChange">
            <view class="row">
                <text class="row-label">账户</text>
                <text class="row-value">{{accountName}}</text>
            </view>
        </picker>
        <picker mode="selector" range="{{dayNames}}" value="{{dayIndex}}" bindchange="onDayChange">
            <view class="row">
                <text class="row-label">每月日期</text>
                <text class="row-value">{{dayText}}</text>
            </view>
        </picker>
        <view class="form-row" style="margin-top: 16rpx">
            <input class="form-input" placeholder="备注，选填" value="{{formNote}}" bindinput="onNoteInput" />
            <view class="mini-btn" bindtap="onSave">添加</view>
        </view>
        <text class="hint-text">每次打开小程序时按日期补生成账目，用规则 ID + 日期做幂等，不会重复记账。日期上限 28 日。</text>
    </view>

    <view class="card">
        <text class="section-title">已有规则</text>
        <view wx:if="{{rows.length === 0}}" class="state">还没有周期规则</view>
        <view wx:if="{{rows.length > 0}}" class="list-item" wx:for="{{rows}}" wx:key="id">
            <view class="item-main">
                <text class="item-title">{{item.title}} · ¥ {{item.amountYuan}}</text>
                <text class="item-sub">{{item.accountName}} · 下次 {{item.nextRunAt}} · {{item.statusText}}</text>
            </view>
            <view class="item-actions">
                <view class="mini-btn ghost" data-id="{{item.id}}" catchtap="onToggle">{{item.enabled ? '停用' : '启用'}}</view>
                <view class="mini-btn danger" data-id="{{item.id}}" catchtap="onDelete">删除</view>
            </view>
        </view>
    </view>
</view>
