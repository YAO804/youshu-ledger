<view class="page">
    <view class="hero">
        <text class="hero-title">有数记账</text>
        <text class="hero-desc">登录是可选的。不登录也能直接记账，内置「默认账户」开箱即用。</text>
    </view>

    <view wx:if="{{!cloudAvailable}}" class="notice">云服务组件未加载，当前只能本地试用。可以先返回直接记账，账目不会丢。</view>

    <block wx:if="{{cloudAvailable && !signedIn}}">
        <login-panel bind:signedin="onSignedIn" />
        <view class="divider"><text>或</text></view>
        <button class="wb-login" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="onWorkBuddyLogin">使用 WorkBuddy 登录</button>
        <text wx:if="{{loginError}}" class="login-error">{{loginError}}</text>
    </block>

    <view wx:if="{{signedIn}}" class="notice">已登录，正在把本地试用账目同步到云端…{{loginError}}</view>

    <button class="skip-login" bindtap="onSkip">先不登录，直接记账</button>
</view>
