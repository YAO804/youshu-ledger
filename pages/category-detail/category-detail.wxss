.summary {
    display: flex;
    min-width: 0;
    flex-direction: column;
}

.summary-head {
    display: flex;
    min-width: 0;
    align-items: center;
}

.summary-name {
    min-width: 0;
    font-size: 32rpx;
    font-weight: 500;
    overflow-wrap: break-word;
}

.summary-tag {
    flex-shrink: 0;
    margin-left: 16rpx;
    padding: 2rpx 14rpx;
    border-radius: 8rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 22rpx;
    line-height: 36rpx;
}

.summary-amount {
    margin-top: 16rpx;
    font-size: 60rpx;
    font-weight: 500;
    white-space: nowrap;
}

.summary-meta {
    display: flex;
    flex-wrap: wrap;
    margin-top: 12rpx;
}

.meta-item {
    margin-right: 20rpx;
    font-size: 23rpx;
    line-height: 1.8;
    color: var(--text-secondary);
    white-space: nowrap;
}

/* 四选一排序，两列铺满，避免文字被挤成省略号 */
.sort-grid {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    margin-top: 20rpx;
}

.sort-item {
    box-sizing: border-box;
    width: 50%;
    padding: 20rpx 8rpx;
    border-radius: 12rpx;
    font-size: 26rpx;
    text-align: center;
    color: var(--text-secondary);
    overflow-wrap: break-word;
}

.sort-item.active {
    background: #eaf2ff;
    color: var(--brand);
    font-weight: 500;
}

.records {
    padding-top: 8rpx;
    padding-bottom: 8rpx;
}

.rec-row {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 22rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
}

.rec-row:last-child {
    border-bottom: none;
}

.rec-main {
    flex: 1;
    min-width: 0;
}

.rec-head {
    display: flex;
    min-width: 0;
    align-items: baseline;
}

.rec-date {
    flex-shrink: 0;
    font-size: 26rpx;
    color: var(--text-primary);
    white-space: nowrap;
}

.rec-account {
    min-width: 0;
    margin-left: 16rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
    overflow-wrap: break-word;
}

.rec-note {
    display: block;
    margin-top: 6rpx;
    font-size: 24rpx;
    line-height: 1.5;
    color: var(--text-secondary);
    overflow-wrap: break-word;
}

.rec-amount {
    flex-shrink: 0;
    margin-left: 20rpx;
    font-size: 30rpx;
    white-space: nowrap;
}

.rec-hint {
    display: block;
    padding: 16rpx 0 8rpx;
    font-size: 22rpx;
    text-align: center;
    color: var(--text-secondary);
}
