.section-title {
    display: block;
}

.csv-input {
    box-sizing: border-box;
    width: 100%;
    height: 200rpx;
    margin: 16rpx 0;
    padding: 16rpx;
    border-radius: 12rpx;
    background: #f5f7fa;
    font-size: 24rpx;
}

.hint-text {
    display: block;
}

/* CSV 示例是无空格长串，必须允许任意位置换行才不会被裁掉 */
.csv-line {
    word-break: break-all;
    padding: 8rpx;
}
