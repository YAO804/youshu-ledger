.budget-hint {
    margin-bottom: 24rpx;
    padding: 20rpx 28rpx;
    border-radius: 16rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 26rpx;
}

.budget-hint.over {
    background: #fdeceb;
    color: var(--expense);
}

.hero-card {
    display: flex;
    flex-direction: column;
}

.hero-label {
    font-size: 26rpx;
    color: var(--text-secondary);
}

.hero-amount {
    margin-top: 12rpx;
    font-size: 68rpx;
    font-weight: 600;
}

.hero-row {
    display: flex;
    margin-top: 32rpx;
    padding-top: 24rpx;
    border-top: 1rpx solid #f0f1f3;
}

.hero-cell {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.hero-cell-label {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.hero-cell-value {
    margin-top: 8rpx;
    font-size: 34rpx;
    font-weight: 500;
}

.metric-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.metric-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 48%;
    margin-bottom: 16rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    background: var(--surface);
}

.metric-label {
    font-size: 22rpx;
    color: var(--text-secondary);
}

.metric-value {
    margin-top: 10rpx;
    font-size: 30rpx;
    font-weight: 500;
}

.card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-head .section-title {
    flex: 1;
}

.more {
    padding: 8rpx;
    font-size: 24rpx;
    color: var(--brand);
}

.stack {
    display: flex;
    height: 24rpx;
    margin: 8rpx 0 28rpx;
    border-radius: 12rpx;
    overflow: hidden;
    background: #f0f1f3;
}

.stack-seg {
    height: 100%;
}

.cat-row {
    padding: 16rpx 0;
}

.cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 26rpx;
}

.cat-name {
    display: flex;
    align-items: center;
}

.dot {
    width: 16rpx;
    height: 16rpx;
    margin-right: 12rpx;
    border-radius: 8rpx;
}

.cat-track {
    height: 12rpx;
    margin-top: 14rpx;
    border-radius: 6rpx;
    overflow: hidden;
    background: #f0f1f3;
}

.cat-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.cat-fill.over {
    background: var(--expense);
}

.cat-more {
    padding-top: 16rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.legend {
    display: flex;
    padding: 0 8rpx 16rpx;
    font-size: 22rpx;
}

.legend-item {
    margin-right: 24rpx;
}

.trend-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 200rpx;
    padding: 16rpx 8rpx 0;
    border-radius: 12rpx;
    background: #f7f8fa;
}

.trend-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.trend-bars {
    display: flex;
    align-items: flex-end;
    height: 140rpx;
}

.bar {
    width: 16rpx;
    margin: 0 3rpx;
    border-radius: 4rpx 4rpx 0 0;
}

.income-bar {
    background: var(--income);
}

.expense-bar {
    background: var(--expense);
}

.trend-label {
    margin: 10rpx 0;
    font-size: 20rpx;
    color: var(--text-secondary);
}

.acct-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
    font-size: 26rpx;
}

.acct-row:last-child {
    border-bottom: none;
}

.record-main {
    display: flex;
    flex-direction: column;
}

.record-category {
    font-size: 28rpx;
}

.record-meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.record-amount {
    font-size: 30rpx;
}
