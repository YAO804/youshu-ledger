/* 云端降级提示：必须完整换行，不能省略 */
.storage-banner {
    display: block;
    margin-bottom: 24rpx;
    padding: 20rpx 28rpx;
    border-radius: 16rpx;
    background: #fff6e5;
    color: #8a5a00;
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
}

.budget-hint {
    margin-bottom: 24rpx;
    padding: 20rpx 28rpx;
    border-radius: 16rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 26rpx;
}

.budget-hint.over {
    background: #fdeceb;
    color: var(--expense);
}

.hero-card {
    display: flex;
    flex-direction: column;
}

.hero-label {
    font-size: 26rpx;
    color: var(--text-secondary);
}

.hero-amount {
    margin-top: 12rpx;
    font-size: 68rpx;
    font-weight: 600;
}

.hero-row {
    display: flex;
    margin-top: 32rpx;
    padding-top: 24rpx;
    border-top: 1rpx solid #f0f1f3;
}

.hero-cell {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.hero-cell-label {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.hero-cell-value {
    margin-top: 8rpx;
    font-size: 34rpx;
    font-weight: 500;
}

.metric-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.metric-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    width: 48%;
    margin-bottom: 16rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    background: var(--surface);
}

.metric-label {
    font-size: 22rpx;
    color: var(--text-secondary);
}

.metric-value {
    margin-top: 10rpx;
    font-size: 30rpx;
    font-weight: 500;
}

.card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-head .section-title {
    flex: 1;
}

.more {
    padding: 8rpx;
    font-size: 24rpx;
    color: var(--brand);
}

/* 100% 堆叠条：一眼看清各分类占比，加粗后成为这张卡的主视觉 */
.stack {
    display: flex;
    height: 32rpx;
    margin: 8rpx 0 12rpx;
    border-radius: 16rpx;
    overflow: hidden;
    background: #f0f1f3;
}

.stack-seg {
    box-sizing: border-box;
    height: 100%;
}

/* 单行图例：不再重复画每条进度条，改为「色点 + 名称 + 金额 + 占比笔数」 */
.cat-item {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 18rpx 0;
    border-bottom: 1rpx solid #f5f6f8;
}

.cat-item:last-child {
    border-bottom: none;
}

/* 整行可点，进分类明细 */
.cat-item-hover {
    opacity: 0.55;
}

.dot {
    flex-shrink: 0;
    width: 14rpx;
    height: 14rpx;
    margin-right: 14rpx;
    border-radius: 7rpx;
}

.cat-label {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    overflow-wrap: break-word;
}

.cat-amount {
    flex-shrink: 0;
    margin-left: 12rpx;
    font-size: 28rpx;
    font-weight: 500;
    white-space: nowrap;
}

/* 固定宽度 + 右对齐，保证各行占比/笔数成一列对齐 */
.cat-meta {
    flex-shrink: 0;
    width: 136rpx;
    margin-left: 14rpx;
    text-align: right;
    font-size: 22rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}

.cat-chevron {
    flex-shrink: 0;
    margin-left: 6rpx;
    color: #d5d3cc;
    font-size: 26rpx;
    line-height: 1;
}

.cat-more {
    padding-top: 16rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

/* 预算进度卡仍是「名称+数值 / 进度条」两行结构，沿用 cat-row 系列 */
.cat-row {
    padding: 16rpx 0;
}

.cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 26rpx;
}

.cat-track {
    height: 12rpx;
    margin-top: 14rpx;
    border-radius: 6rpx;
    overflow: hidden;
    background: #f0f1f3;
}

.cat-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.cat-fill.over {
    background: var(--expense);
}

.legend {
    display: flex;
    padding: 0 8rpx 16rpx;
    font-size: 22rpx;
}

.legend-item {
    margin-right: 24rpx;
}

.trend-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 200rpx;
    padding: 16rpx 8rpx 0;
    border-radius: 12rpx;
    background: #f7f8fa;
}

.trend-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.trend-bars {
    display: flex;
    align-items: flex-end;
    height: 140rpx;
}

.bar {
    width: 16rpx;
    margin: 0 3rpx;
    border-radius: 4rpx 4rpx 0 0;
}

.income-bar {
    background: var(--income);
}

.expense-bar {
    background: var(--expense);
}

.trend-label {
    margin: 10rpx 0;
    font-size: 20rpx;
    color: var(--text-secondary);
}

.acct-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
    font-size: 26rpx;
}

.acct-row:last-child {
    border-bottom: none;
}

.record-main {
    display: flex;
    flex-direction: column;
}

.record-category {
    font-size: 28rpx;
}

.record-meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.record-amount {
    font-size: 30rpx;
}

/* 文字显示完整性：金额不折行、长名称可省略、指标值允许换行显示完整 */
.hero-card,
.hero-cell,
.metric-card,
.card-head,
.cat-item,
.acct-row,
.record-main {
    min-width: 0;
}

.hero-amount {
    font-size: 60rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hero-cell-value {
    font-size: 32rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.metric-card {
    min-height: 130rpx;
    justify-content: center;
}

.metric-value {
    line-height: 1.35;
    overflow-wrap: break-word;
}

.card-head .section-title {
    min-width: 0;
}

.more {
    flex-shrink: 0;
    white-space: nowrap;
}

.acct-row .row-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
}

.acct-row .row-value {
    flex-shrink: 0;
    white-space: nowrap;
}

.record-main {
    flex: 1;
}

.record-category,
.record-meta {
    min-width: 0;
    line-height: 1.5;
    overflow-wrap: break-word;
}

.record-amount {
    flex-shrink: 0;
    margin-left: 16rpx;
    white-space: nowrap;
}

.budget-hint {
    line-height: 1.6;
    overflow-wrap: break-word;
}

.trend-label {
    white-space: nowrap;
}
