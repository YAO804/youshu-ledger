.budget-hint {
    margin-bottom: 20rpx;
    padding: 14rpx 24rpx;
    border-radius: 16rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
}

.budget-hint.over {
    background: #fdeceb;
    color: var(--expense);
}

/* 顶部概览卡：月份切换 + 结余 + 收支 + 指标条，合成一张卡。
   原先是「月份卡 + 结余卡 + 2×2 指标大方块」三块叠在首屏，把下面的支出构成顶出去了。 */
.overview-card {
    padding: 20rpx 32rpx 26rpx;
}

/* 月份切换嵌在卡顶，去掉独立卡片的 padding，按钮缩一号 */
.overview-card .month-bar {
    padding: 0 0 4rpx;
}

.overview-card .month-btn {
    width: 56rpx;
    height: 56rpx;
    line-height: 52rpx;
    font-size: 34rpx;
}

.overview-card .month-label {
    font-size: 26rpx;
}

.hero-label {
    display: block;
    margin-top: 10rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
}

.hero-amount {
    display: block;
    margin-top: 2rpx;
    font-size: 56rpx;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 收支不再单独加分隔线与大留白，紧贴结余数字 */
.hero-row {
    display: flex;
    margin-top: 14rpx;
}

.hero-cell {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
}

.hero-cell-label {
    font-size: 22rpx;
    color: var(--text-secondary);
}

.hero-cell-value {
    margin-top: 4rpx;
    font-size: 30rpx;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 指标条：4 列内联，替代原来的 2×2 大方块，高度从 ~290rpx 压到 ~90rpx */
.metric-strip {
    display: flex;
    margin-top: 20rpx;
    padding-top: 18rpx;
    border-top: 1rpx solid #f0f1f3;
}

.metric-cell {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
}

.metric-label {
    font-size: 22rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}

.metric-value {
    margin-top: 6rpx;
    font-size: 26rpx;
    font-weight: 500;
    line-height: 1.35;
    overflow-wrap: break-word;
}

.more {
    padding: 8rpx;
    font-size: 24rpx;
    color: var(--brand);
}

/* 100% 堆叠条：一眼看清各分类占比，加粗后成为这张卡的主视觉 */
.stack {
    display: flex;
    height: 32rpx;
    margin: 8rpx 0 12rpx;
    border-radius: 16rpx;
    overflow: hidden;
    background: #f0f1f3;
}

.stack-seg {
    box-sizing: border-box;
    height: 100%;
}

/* 单行图例：不再重复画每条进度条，改为「色点 + 名称 + 金额 + 占比笔数」 */
.cat-item {
    display: flex;
    min-width: 0;
    align-items: center;
    padding: 18rpx 0;
    border-bottom: 1rpx solid #f5f6f8;
}

.cat-item:last-child {
    border-bottom: none;
}

/* 整行可点，进分类明细 */
.cat-item-hover {
    opacity: 0.55;
}

.dot {
    flex-shrink: 0;
    width: 14rpx;
    height: 14rpx;
    margin-right: 14rpx;
    border-radius: 7rpx;
}

.cat-label {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    overflow-wrap: break-word;
}

.cat-amount {
    flex-shrink: 0;
    margin-left: 12rpx;
    font-size: 28rpx;
    font-weight: 500;
    white-space: nowrap;
}

/* 固定宽度 + 右对齐，保证各行占比/笔数成一列对齐 */
.cat-meta {
    flex-shrink: 0;
    width: 136rpx;
    margin-left: 14rpx;
    text-align: right;
    font-size: 22rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}

.cat-chevron {
    flex-shrink: 0;
    margin-left: 6rpx;
    color: #d5d3cc;
    font-size: 26rpx;
    line-height: 1;
}

.cat-more {
    padding-top: 16rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

/* 预算进度卡仍是「名称+数值 / 进度条」两行结构，沿用 cat-row 系列 */
.cat-row {
    padding: 16rpx 0;
}

.cat-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 26rpx;
}

.cat-track {
    height: 12rpx;
    margin-top: 14rpx;
    border-radius: 6rpx;
    overflow: hidden;
    background: #f0f1f3;
}

.cat-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.cat-fill.over {
    background: var(--expense);
}

.legend {
    display: flex;
    padding: 0 8rpx 16rpx;
    font-size: 22rpx;
}

.legend-item {
    margin-right: 24rpx;
}

.trend-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 200rpx;
    padding: 16rpx 8rpx 0;
    border-radius: 12rpx;
    background: #f7f8fa;
}

.trend-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.trend-bars {
    display: flex;
    align-items: flex-end;
    height: 140rpx;
}

.bar {
    width: 16rpx;
    margin: 0 3rpx;
    border-radius: 4rpx 4rpx 0 0;
}

.income-bar {
    background: var(--income);
}

.expense-bar {
    background: var(--expense);
}

.trend-label {
    margin: 10rpx 0;
    font-size: 20rpx;
    color: var(--text-secondary);
}

.acct-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 0;
    border-bottom: 1rpx solid #f0f1f3;
    font-size: 26rpx;
}

.acct-row:last-child {
    border-bottom: none;
}

/* 文字显示完整性：金额不折行、长名称可省略、指标值允许换行显示完整 */
.card-head,
.cat-item,
.acct-row {
    min-width: 0;
}

.more {
    flex-shrink: 0;
    white-space: nowrap;
}

.acct-row .row-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
}

.acct-row .row-value {
    flex-shrink: 0;
    white-space: nowrap;
}

.trend-label {
    white-space: nowrap;
}
