.month-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 32rpx;
}

.month-btn {
    width: 64rpx;
    height: 64rpx;
    line-height: 60rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #f2f3f5;
    font-size: 40rpx;
    color: var(--text-secondary);
}

.month-label {
    font-size: 30rpx;
    font-weight: 500;
}

.budget-hint {
    margin-bottom: 24rpx;
    padding: 20rpx 28rpx;
    border-radius: 16rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 26rpx;
}

.budget-hint.over {
    background: #fdeceb;
    color: var(--expense);
}

.summary {
    display: flex;
    flex-direction: column;
}

.summary-label {
    font-size: 26rpx;
    color: var(--text-secondary);
}

.summary-amount {
    margin-top: 16rpx;
    font-size: 64rpx;
    font-weight: 500;
}

.summary-row {
    display: flex;
    margin-top: 32rpx;
    padding-top: 24rpx;
    border-top: 1rpx solid #f0f1f3;
}

.summary-cell {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.summary-cell-label {
    font-size: 24rpx;
    color: var(--text-secondary);
}

.summary-cell-value {
    margin-top: 8rpx;
    font-size: 32rpx;
}

.record-main {
    display: flex;
    flex-direction: column;
}

.record-category {
    font-size: 28rpx;
}

.record-meta {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.record-amount {
    font-size: 30rpx;
}
