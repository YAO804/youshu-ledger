<view class="page">
    <view class="card month-bar">
        <view class="month-btn" bindtap="onPrevMonth">‹</view>
        <text class="month-label">{{monthLabel}}</text>
        <view class="month-btn" bindtap="onNextMonth">›</view>
    </view>

    <view class="card summary">
        <text class="summary-label">本月结余</text>
        <text class="summary-amount">¥ {{balanceText}}</text>
        <view class="summary-row">
            <view class="summary-cell">
                <text class="summary-cell-label">收入</text>
                <text class="summary-cell-value income">¥ {{incomeText}}</text>
            </view>
            <view class="summary-cell">
                <text class="summary-cell-label">支出</text>
                <text class="summary-cell-value expense">¥ {{expenseText}}</text>
            </view>
        </view>
    </view>

    <view wx:if="{{budgetHint}}" class="budget-hint {{budgetOver ? 'over' : ''}}">{{budgetHint}}</view>

    <view class="section-title">
        <text>账目明细</text>
        <text class="section-hint">共 {{recordCount}} 笔 · 长按可删除</text>
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="state">正在加载账目…</view>
    <view wx:elif="{{viewState === 'error'}}" class="state">{{errorText}}</view>
    <view wx:elif="{{records.length === 0}}" class="state">本月还没有账目，点「记一笔」开始记录</view>
    <view wx:else class="card">
        <view class="row record-row" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindlongpress="onDeleteRecord">
            <view class="record-main">
                <text class="record-category">{{item.categoryName}}</text>
                <text class="record-meta">{{item.dateText}} · {{item.accountName}} {{item.noteText}}</text>
            </view>
            <text class="record-amount {{item.type === 'income' ? 'income' : 'expense'}}">{{item.amountText}}</text>
        </view>
    </view>
</view>
