<view class="page">
    <view class="card month-bar">
        <view class="month-btn" bindtap="onPrevMonth">‹</view>
        <text class="month-label">{{monthLabel}}</text>
        <view class="month-btn" bindtap="onNextMonth">›</view>
    </view>

    <view class="card">
        <view class="card-head">
            <text class="section-title">收支趋势</text>
            <text class="trend-tip">近 12 个月</text>
        </view>
        <view class="legend">
            <text class="legend-item income">■ 收入</text>
            <text class="legend-item expense">■ 支出</text>
            <text class="legend-tip">点柱子切到该月 ›</text>
        </view>
        <scroll-view class="trend-scroll" scroll-x scroll-with-animation scroll-into-view="{{scrollTarget}}">
            <view class="trend-chart">
                <view
                    class="trend-col {{item.id === month ? 'active' : ''}}"
                    wx:for="{{trendRows}}"
                    wx:key="id"
                    id="trend-{{item.id}}"
                    data-month="{{item.id}}"
                    bindtap="onTrendTap"
                    hover-class="trend-col-hover"
                >
                    <view class="trend-bars">
                        <view class="bar income-bar" style="height: {{item.incomeHeight}}%"></view>
                        <view class="bar expense-bar" style="height: {{item.expenseHeight}}%"></view>
                    </view>
                    <text class="trend-label">{{item.label}}</text>
                    <text class="trend-year">{{item.yearLabel || ' '}}</text>
                </view>
            </view>
        </scroll-view>
    </view>

    <view class="card">
        <text class="section-title">支出分类占比</text>
        <view wx:if="{{categoryRows.length === 0}}" class="state">本月暂无支出数据</view>
        <view wx:if="{{categoryRows.length > 0}}" class="cat-row" wx:for="{{categoryRows}}" wx:key="id" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="onCategoryTap" hover-class="cat-row-hover">
            <view class="cat-top">
                <text class="cat-label">{{item.name}}</text>
                <text class="cat-amount">{{item.amountText}}</text>
                <text class="cat-chevron">›</text>
            </view>
            <view class="cat-bot">
                <view class="cat-track">
                    <view class="cat-fill" style="width: {{item.percent}}%"></view>
                </view>
                <text class="cat-meta">{{item.percentText}} · {{item.count}} 笔</text>
            </view>
        </view>
    </view>

    <view class="card">
        <text class="section-title">预算进度</text>
        <view wx:if="{{budgetRows.length === 0}}" class="state">本月未设置预算，可在「我的」里添加</view>
        <view wx:if="{{budgetRows.length > 0}}" class="budget-row" wx:for="{{budgetRows}}" wx:key="id">
            <view class="budget-head">
                <text class="row-label">{{item.name}}</text>
                <text class="row-value {{item.over ? 'expense' : ''}}">{{item.usedText}} / {{item.limitText}}</text>
            </view>
            <view class="budget-track">
                <view class="budget-fill {{item.over ? 'over' : ''}}" style="width: {{item.percent}}%"></view>
            </view>
        </view>
    </view>
</view>
