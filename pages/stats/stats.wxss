.chart-placeholder {
    display: flex;
    height: 240rpx;
    align-items: center;
    justify-content: center;
    border-radius: 12rpx;
    background: #f7f8fa;
    font-size: 24rpx;
    color: var(--text-secondary);
}

.budget-row {
    padding: 16rpx 0;
}

.budget-head {
    display: flex;
    justify-content: space-between;
}

.budget-track {
    height: 12rpx;
    margin-top: 16rpx;
    border-radius: 6rpx;
    background: #f0f1f3;
    overflow: hidden;
}

.budget-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-fill.over {
    background: var(--expense);
}
