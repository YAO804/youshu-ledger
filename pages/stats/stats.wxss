.month-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 32rpx;
}

.month-btn {
    width: 64rpx;
    height: 64rpx;
    line-height: 60rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #f2f3f5;
    font-size: 40rpx;
    color: var(--text-secondary);
}

.month-label {
    font-size: 30rpx;
    font-weight: 500;
}

.legend {
    display: flex;
    padding: 0 8rpx 16rpx;
    font-size: 22rpx;
}

.legend-item {
    margin-right: 24rpx;
}

.trend-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 200rpx;
    padding: 16rpx 8rpx 0;
    background: #f7f8fa;
    border-radius: 12rpx;
}

.trend-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.trend-bars {
    display: flex;
    align-items: flex-end;
    height: 140rpx;
}

.bar {
    width: 16rpx;
    margin: 0 3rpx;
    border-radius: 4rpx 4rpx 0 0;
}

.income-bar {
    background: var(--income);
}

.expense-bar {
    background: var(--expense);
}

.trend-label {
    margin: 10rpx 0;
    font-size: 20rpx;
    color: var(--text-secondary);
}

.cat-row {
    padding: 14rpx 0;
}

.cat-head,
.budget-head {
    display: flex;
    justify-content: space-between;
}

.cat-track,
.budget-track {
    height: 12rpx;
    margin-top: 14rpx;
    border-radius: 6rpx;
    background: #f0f1f3;
    overflow: hidden;
}

.cat-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-row {
    padding: 16rpx 0;
}

.budget-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-fill.over {
    background: var(--expense);
}
