.month-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 32rpx;
}

.month-btn {
    width: 64rpx;
    height: 64rpx;
    line-height: 60rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #f2f3f5;
    font-size: 40rpx;
    color: var(--text-secondary);
}

.month-label {
    font-size: 30rpx;
    font-weight: 500;
}

.legend {
    display: flex;
    align-items: center;
    padding: 0 8rpx 16rpx;
    font-size: 22rpx;
}

.legend-item {
    margin-right: 24rpx;
}

/* 提示靠右，告诉用户柱子可点 */
.legend-tip {
    margin-left: auto;
    color: var(--text-secondary);
}

.trend-tip {
    flex-shrink: 0;
    font-size: 22rpx;
    color: var(--text-secondary);
}

/* 横向滚动容器：scroll-view 必须给固定高度，否则内容撑不开会塌成 0 */
.trend-scroll {
    width: 100%;
    height: 250rpx;
    background: #f7f8fa;
    border-radius: 12rpx;
    white-space: nowrap;
}

/* inline-flex 让内容按 12 根柱子撑宽，超出容器就产生横向滚动 */
.trend-chart {
    display: inline-flex;
    align-items: flex-end;
    box-sizing: border-box;
    height: 250rpx;
    padding: 0 8rpx;
}

/* 固定列宽，柱子才有均匀的间距和足够大的点击区 */
.trend-col {
    display: flex;
    flex: 0 0 96rpx;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 10rpx 0 12rpx;
    border-radius: 12rpx;
}

/* 选中月整列铺一层浅色底，比只改文字颜色更容易认出来 */
.trend-col.active {
    background: rgba(47, 111, 237, 0.1);
}

.trend-col-hover {
    background: rgba(0, 0, 0, 0.04);
}

.trend-bars {
    display: flex;
    align-items: flex-end;
    height: 140rpx;
}

/* 柱子高度用百分比，跟着 .trend-bars 的 140rpx 走，数据层的 0~100 直接映射 */
.bar {
    width: 20rpx;
    margin: 0 4rpx;
    border-radius: 6rpx 6rpx 0 0;
}

.income-bar {
    background: var(--income);
}

.expense-bar {
    background: var(--expense);
}

.trend-label {
    margin-top: 12rpx;
    font-size: 20rpx;
    line-height: 26rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}

/* 年份只在 1 月和窗口第一根柱子出现，空值也占一行高度，保证各列柱底对齐 */
.trend-year {
    font-size: 18rpx;
    line-height: 22rpx;
    color: #b9bec7;
    white-space: nowrap;
}

.trend-col.active .trend-label {
    color: var(--brand);
    font-weight: 600;
}

.cat-row {
    padding: 18rpx 0;
}

/* 整行可点，进分类明细 */
.cat-row-hover {
    opacity: 0.55;
}

/* 第一行：分类名 + 金额 */
.cat-top {
    display: flex;
    min-width: 0;
    align-items: center;
}

.cat-label {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    overflow-wrap: break-word;
}

.cat-amount {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 28rpx;
    font-weight: 500;
    white-space: nowrap;
}

.cat-chevron {
    flex-shrink: 0;
    margin-left: 4rpx;
    color: #c4c2bb;
    font-size: 28rpx;
    line-height: 1;
}

/* 第二行：进度条 + 占比与笔数 */
.cat-bot {
    display: flex;
    min-width: 0;
    align-items: center;
    margin-top: 12rpx;
}

.cat-meta {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}

.budget-head {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
}

.cat-track {
    flex: 1;
    min-width: 0;
    height: 10rpx;
    border-radius: 5rpx;
    background: #f0f1f3;
    overflow: hidden;
}

.budget-track {
    height: 12rpx;
    margin-top: 14rpx;
    border-radius: 6rpx;
    background: #f0f1f3;
    overflow: hidden;
}

.cat-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-row {
    padding: 16rpx 0;
}

.budget-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-fill.over {
    background: var(--expense);
}

/* 左名称可省略、右数值保持完整，避免长分类名把金额挤出屏幕 */
.budget-head {
    min-width: 0;
}

.budget-head .row-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
}

.budget-head .row-value {
    flex-shrink: 0;
    max-width: 55%;
    white-space: nowrap;
}
