.month-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 32rpx;
}

.month-btn {
    width: 64rpx;
    height: 64rpx;
    line-height: 60rpx;
    text-align: center;
    border-radius: 32rpx;
    background: #f2f3f5;
    font-size: 40rpx;
    color: var(--text-secondary);
}

.month-label {
    font-size: 30rpx;
    font-weight: 500;
}

.legend {
    display: flex;
    padding: 0 8rpx 16rpx;
    font-size: 22rpx;
}

.legend-item {
    margin-right: 24rpx;
}

.trend-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    height: 200rpx;
    padding: 16rpx 8rpx 0;
    background: #f7f8fa;
    border-radius: 12rpx;
}

.trend-col {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.trend-bars {
    display: flex;
    align-items: flex-end;
    height: 140rpx;
}

.bar {
    width: 16rpx;
    margin: 0 3rpx;
    border-radius: 4rpx 4rpx 0 0;
}

.income-bar {
    background: var(--income);
}

.expense-bar {
    background: var(--expense);
}

.trend-label {
    margin: 10rpx 0;
    font-size: 20rpx;
    color: var(--text-secondary);
}

.cat-row {
    padding: 18rpx 0;
}

/* 整行可点，进分类明细 */
.cat-row-hover {
    opacity: 0.55;
}

/* 第一行：分类名 + 金额 */
.cat-top {
    display: flex;
    min-width: 0;
    align-items: center;
}

.cat-label {
    flex: 1;
    min-width: 0;
    font-size: 28rpx;
    overflow-wrap: break-word;
}

.cat-amount {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 28rpx;
    font-weight: 500;
    white-space: nowrap;
}

.cat-chevron {
    flex-shrink: 0;
    margin-left: 4rpx;
    color: #c4c2bb;
    font-size: 28rpx;
    line-height: 1;
}

/* 第二行：进度条 + 占比与笔数 */
.cat-bot {
    display: flex;
    min-width: 0;
    align-items: center;
    margin-top: 12rpx;
}

.cat-meta {
    flex-shrink: 0;
    margin-left: 16rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
    white-space: nowrap;
}

.budget-head {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: space-between;
}

.cat-track {
    flex: 1;
    min-width: 0;
    height: 10rpx;
    border-radius: 5rpx;
    background: #f0f1f3;
    overflow: hidden;
}

.budget-track {
    height: 12rpx;
    margin-top: 14rpx;
    border-radius: 6rpx;
    background: #f0f1f3;
    overflow: hidden;
}

.cat-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-row {
    padding: 16rpx 0;
}

.budget-fill {
    height: 100%;
    border-radius: 6rpx;
    background: var(--brand);
}

.budget-fill.over {
    background: var(--expense);
}

/* 左名称可省略、右数值保持完整，避免长分类名把金额挤出屏幕 */
.budget-head,
.trend-col {
    min-width: 0;
}

.budget-head .row-label {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
}

.budget-head .row-value {
    flex-shrink: 0;
    max-width: 55%;
    white-space: nowrap;
}

.trend-label {
    white-space: nowrap;
}
