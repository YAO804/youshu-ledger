.profile {
    display: flex;
    align-items: center;
}

.avatar {
    display: flex;
    flex-shrink: 0;
    width: 96rpx;
    height: 96rpx;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 48rpx;
    background: linear-gradient(135deg, #eaf2ff 0%, #f6ecff 100%);
}

.avatar-img {
    width: 96rpx;
    height: 96rpx;
}

.avatar-emoji {
    font-size: 52rpx;
    line-height: 60rpx;
}

.profile-info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    margin-left: 24rpx;
}

/* 昵称 + 编辑标识：昵称可以换行，编辑标识始终完整显示 */
.nickname-row {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
}

.nickname-text {
    display: block;
    min-width: 0;
    margin-right: 16rpx;
    overflow-wrap: break-word;
    font-size: 30rpx;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-primary);
}

.edit-chip {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    padding: 4rpx 14rpx;
    border-radius: 20rpx;
    background: #f2f3f5;
}

.edit-chip-icon {
    margin-right: 6rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.edit-chip-text {
    font-size: 22rpx;
    color: var(--text-secondary);
}

.nickname-input {
    min-width: 0;
    height: 60rpx;
    padding: 0 16rpx;
    border-radius: 10rpx;
    background: #f5f7fa;
    font-size: 30rpx;
}

.profile-desc {
    display: block;
    margin-top: 8rpx;
    overflow-wrap: break-word;
    font-size: 22rpx;
    line-height: 1.5;
    color: var(--text-secondary);
}

/* 头像选择：仅编辑态出现 */
.avatar-picker {
    margin-bottom: 24rpx;
    padding: 24rpx 32rpx 28rpx;
    border-radius: 20rpx;
    background: var(--surface);
}

.picker-title {
    display: block;
    padding-bottom: 16rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
}

.avatar-grid {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
}

.avatar-option {
    display: flex;
    width: 76rpx;
    height: 76rpx;
    margin: 0 14rpx 14rpx 0;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 3rpx solid transparent;
    border-radius: 38rpx;
    background: #f6f7f9;
}

.avatar-option.active {
    border-color: var(--brand);
    background: #eaf2ff;
}

.avatar-option-emoji {
    font-size: 40rpx;
    line-height: 44rpx;
}

/* 最后一个格子：上传自己的照片，没选过就是虚线加号 */
.avatar-upload {
    border-style: dashed;
    border-color: #d5d8de;
    background: #fafbfc;
}

.avatar-upload.active {
    border-style: solid;
    border-color: var(--brand);
}

.avatar-option-img {
    width: 70rpx;
    height: 70rpx;
    border-radius: 35rpx;
}

.avatar-upload-plus {
    font-size: 40rpx;
    line-height: 44rpx;
    color: var(--text-secondary);
}

.picker-hint {
    display: block;
    overflow-wrap: break-word;
    font-size: 22rpx;
    line-height: 1.5;
    color: var(--text-secondary);
}

.edit-bar {
    display: flex;
    min-width: 0;
    margin-bottom: 24rpx;
}

.edit-btn {
    flex: 1;
    min-width: 0;
    height: 80rpx;
    line-height: 80rpx;
    border-radius: 16rpx;
    text-align: center;
    font-size: 28rpx;
}

.edit-btn + .edit-btn {
    margin-left: 20rpx;
}

.edit-btn.ghost {
    background: #f2f3f5;
    color: var(--text-primary);
}

.edit-btn.primary {
    background: var(--brand);
    color: #ffffff;
    font-weight: 500;
}

.notice {
    margin-bottom: 24rpx;
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    background: #fff7e8;
    color: #8a5a12;
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
}

.group-title {
    display: block;
    padding-bottom: 12rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
}

/* 存储方式切换：两段式，选中项白底高亮；不可用时置灰但仍可点（点了给原因） */
.mode-switch {
    display: flex;
    min-width: 0;
    margin: 20rpx 0 8rpx;
    padding: 6rpx;
    border-radius: 14rpx;
    background: #f2f2f0;
}

.mode-option {
    flex: 1;
    min-width: 0;
    padding: 18rpx 8rpx;
    border-radius: 10rpx;
    text-align: center;
    font-size: 26rpx;
    color: var(--text-secondary);
    overflow-wrap: break-word;
}

.mode-option.active {
    background: var(--surface);
    color: var(--brand);
    font-weight: 500;
}

.mode-option.disabled {
    color: #c4c2bb;
}

.mode-option.disabled.active {
    color: var(--brand);
}

.danger-btn {
    margin-top: 32rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    background: #ffffff;
    color: var(--expense);
    font-size: 28rpx;
    text-align: center;
}
