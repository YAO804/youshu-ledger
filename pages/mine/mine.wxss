.profile {
    display: flex;
    align-items: center;
}

.avatar {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    align-items: center;
    justify-content: center;
    border-radius: 48rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 40rpx;
}

.profile-info {
    display: flex;
    flex-direction: column;
    margin-left: 24rpx;
}

.profile-name {
    font-size: 32rpx;
}

.profile-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
}

.group-title {
    display: block;
    padding-bottom: 12rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
}
