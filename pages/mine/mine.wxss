.profile {
    display: flex;
    align-items: center;
}

.avatar {
    display: flex;
    width: 96rpx;
    height: 96rpx;
    align-items: center;
    justify-content: center;
    border-radius: 48rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 40rpx;
}

.profile-info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    margin-left: 24rpx;
}

.nickname-input {
    font-size: 30rpx;
}

.profile-desc {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: var(--text-secondary);
}

.save-nick {
    flex-shrink: 0;
    padding: 8rpx 20rpx;
    border-radius: 8rpx;
    background: #eaf2ff;
    color: var(--brand);
    font-size: 24rpx;
}

.notice {
    margin-bottom: 24rpx;
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    background: #fff7e8;
    color: #8a5a12;
    font-size: 24rpx;
    line-height: 1.6;
    overflow-wrap: break-word;
}

.group-title {
    display: block;
    padding-bottom: 12rpx;
    font-size: 24rpx;
    color: var(--text-secondary);
}

/* 存储方式切换：两段式，选中项白底高亮；不可用时置灰但仍可点（点了给原因） */
.mode-switch {
    display: flex;
    min-width: 0;
    margin: 20rpx 0 8rpx;
    padding: 6rpx;
    border-radius: 14rpx;
    background: #f2f2f0;
}

.mode-option {
    flex: 1;
    min-width: 0;
    padding: 18rpx 8rpx;
    border-radius: 10rpx;
    text-align: center;
    font-size: 26rpx;
    color: var(--text-secondary);
    overflow-wrap: break-word;
}

.mode-option.active {
    background: var(--surface);
    color: var(--brand);
    font-weight: 500;
}

.mode-option.disabled {
    color: #c4c2bb;
}

.mode-option.disabled.active {
    color: var(--brand);
}

.danger-btn {
    margin-top: 32rpx;
    padding: 24rpx;
    border-radius: 16rpx;
    background: #ffffff;
    color: var(--expense);
    font-size: 28rpx;
    text-align: center;
}

