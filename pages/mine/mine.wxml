<view class="page">
    <view class="card profile">
        <view class="avatar" bindtap="onAvatarTap">
            <image wx:if="{{avatarImage}}" class="avatar-img" src="{{avatarImage}}" mode="aspectFill" />
            <text wx:else class="avatar-emoji">{{avatarEmoji}}</text>
        </view>
        <view class="profile-info">
            <block wx:if="{{editing}}">
                <input class="nickname-input" value="{{nicknameInput}}" focus="{{editing}}" maxlength="12"
                    placeholder="给这本账起个名字" confirm-type="done"
                    bindinput="onNicknameInput" bindconfirm="onSaveNickname" />
                <text class="profile-desc">点头像换一个 · 共 {{recordCount}} 笔账目 · {{storageText}}</text>
            </block>
            <block wx:else>
                <view class="nickname-row">
                    <text class="nickname-text">{{nicknameText}}</text>
                    <view class="edit-chip" bindtap="onEditStart">
                        <text class="edit-chip-icon">✎</text>
                        <text class="edit-chip-text">编辑</text>
                    </view>
                </view>
                <text class="profile-desc">共 {{recordCount}} 笔账目 · {{storageText}}</text>
            </block>
        </view>
    </view>

    <view class="avatar-picker" wx:if="{{editing}}">
        <text class="picker-title">换个头像</text>
        <view class="avatar-grid">
            <view class="avatar-option {{item.key === draftAvatar ? 'active' : ''}}"
                wx:for="{{avatarOptions}}" wx:key="key" data-key="{{item.key}}" bindtap="onPickAvatar">
                <text class="avatar-option-emoji">{{item.emoji}}</text>
            </view>
        </view>
        <text class="picker-hint">点头像也能换下一个</text>
    </view>

    <view class="edit-bar" wx:if="{{editing}}">
        <view class="edit-btn ghost" bindtap="onCancelEdit">取消</view>
        <view class="edit-btn primary" bindtap="onSaveNickname">保存</view>
    </view>

    <view class="notice">{{notice}}</view>

    <view class="card">
        <text class="section-title">数据存储方式</text>
        <view class="mode-switch">
            <view class="mode-option {{storageMode === 'local' ? 'active' : ''}}" data-mode="local" bindtap="onModeTap">本机账本</view>
            <view class="mode-option {{storageMode === 'cloud' ? 'active' : ''}} {{cloudAvailable ? '' : 'disabled'}}" data-mode="cloud" bindtap="onModeTap">云端共享</view>
        </view>
        <text class="hint-text">{{modeHint}}</text>
    </view>

    <view class="card" wx:for="{{menuGroups}}" wx:for-item="group" wx:key="key">
        <text class="group-title">{{group.title}}</text>
        <view class="row" wx:for="{{group.items}}" wx:for-item="item" wx:key="key" data-path="{{item.path}}" bindtap="onMenuTap">
            <text class="row-label">{{item.text}}</text>
            <text class="row-value">›</text>
        </view>
    </view>

    <view class="danger-btn" bindtap="onReset">清空全部数据</view>
</view>
